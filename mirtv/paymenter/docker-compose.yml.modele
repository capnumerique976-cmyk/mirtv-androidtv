# MirTV : Paymenter (factures, paiements, comptes clients) sur https://compte.mirtv.rahiss.com
# Fichier écrit par installer-paymenter.sh. Aucun secret ici : ils viennent de /etc/mirtv/secrets/paiement.
name: mirtv-paymenter

services:
  database:
    image: mariadb:11.4
    restart: unless-stopped
    command: --default-authentication-plugin=mysql_native_password --innodb-buffer-pool-size=128M
    mem_limit: 512m
    volumes:
      - ./database:/var/lib/mysql
      - /etc/mirtv/secrets/paiement/paymenter_db_password:/run/secrets/db_password:ro
      - /etc/mirtv/secrets/paiement/paymenter_db_root_password:/run/secrets/db_root_password:ro
    environment:
      MARIADB_DATABASE: paymenter
      MARIADB_USER: paymenter
      MARIADB_PASSWORD_FILE: /run/secrets/db_password
      MARIADB_ROOT_PASSWORD_FILE: /run/secrets/db_root_password
    networks: [interne]

  cache:
    image: redis:7-alpine
    restart: unless-stopped
    mem_limit: 128m
    command: redis-server --save "" --appendonly no --maxmemory 96mb --maxmemory-policy allkeys-lru
    networks: [interne]

  paymenter:
    image: ghcr.io/paymenter/paymenter:latest
    restart: unless-stopped
    mem_limit: 768m
    depends_on: [database, cache]
    entrypoint: ["/bin/ash", "/app/mirtv/mirtv-entree.sh"]
    command: ["supervisord", "-n", "-c", "/etc/supervisord.conf"]
    ports:
      - "127.0.0.1:8092:80"
    tmpfs:
      - /app/var:mode=0755,uid=100,gid=101
    volumes:
      - ./storage/logs:/app/storage/logs
      - ./storage/public:/app/storage/app/public
      - ./themes:/app/themes
      - ./extensions:/app/extensions
      - ./mirtv:/app/mirtv:ro
      - ./partage:/opt/mirtv-partage
      - /etc/mirtv/secrets/paiement:/run/secrets-mirtv:ro
    environment:
      APP_ENV: production
      APP_URL: https://compte.mirtv.rahiss.com
      APP_LOCALE: fr
      APP_TIMEZONE: Indian/Antananarivo
      DB_CONNECTION: mariadb
      DB_HOST: database
      DB_PORT: "3306"
      DB_DATABASE: paymenter
      DB_USERNAME: paymenter
      CACHE_STORE: redis
      QUEUE_CONNECTION: redis
      REDIS_HOST: cache
      SESSION_SECURE_COOKIE: "true"
      PAYMENTER_SKIP_DEFAULT: "false"
      MIRTV_SECRETS_DIR: /run/mirtv
      MIRTV_LIMITES_FICHIER: /opt/mirtv-partage/limites-familles.json
      MIRTV_URL_JELLYFIN: http://__JELLYFIN__:8096
    networks: [interne, jellyfin]

networks:
  interne: {}
  jellyfin:
    external: true
    name: __RESEAU_JELLYFIN__
